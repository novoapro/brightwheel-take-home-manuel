# Copy to .env.local for local dev. Never commit real secrets.

# LLM provider keys — ALL OPTIONAL. The primary path is the admin UI
# (Settings → AI provider): set a key per provider there, stored encrypted
# (analysis/11 §3). These env vars are only a bootstrap fallback for local dev,
# so `npm run dev` works before you open the UI.
ANTHROPIC_API_KEY=          # Claude Sonnet 5 answerer + Haiku 4.5 judge (default)
OPENAI_API_KEY=             # GPT-5 family (optional provider)
GOOGLE_API_KEY=             # Gemini Flash (optional provider)

# First-boot provider + model selection (OPTIONAL). Like the keys above, these
# are only a bootstrap default — a provider/model chosen later in /admin is
# stored in the DB and overrides them. FRONTDESK_MODEL applies to the selected
# provider only and must be a valid model id for it (see src/lib/model/registry.ts),
# else it's ignored and the provider's default is used.
FRONTDESK_PROVIDER=         # anthropic | openai | google  (default: anthropic)
FRONTDESK_MODEL=            # e.g. claude-opus-5 · gpt-5 · gemini-pro-latest

# Master key for encrypting UI-entered provider keys at rest (AES-256-GCM,
# analysis/11 §3.3). OPTIONAL: if unset, a per-install key auto-provisions so
# the UI works out of the box. Set it in production so the key lives outside the
# DB. 32 bytes, base64:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
SECRETS_ENCRYPTION_KEY=

# SQLite location. Local default is ./data/app.db; on Railway point this at the
# mounted persistent volume (e.g. /data/app.db).
DATABASE_PATH=./data/app.db

# Operator control center (/admin) mock gate — not real auth (a non-goal).
ADMIN_PASSCODE=change-me

# The prompt-cache TTL for the grounded handbook prefix (5m / 1h, default 1h) is
# an operator setting, not an env var — change it in /admin ▸ Settings ▸ Front
# Desk AI Assistant ▸ Handbook cache (analysis/04 §4.1).
