# Copy to .env.local for local dev. Never commit real secrets.

# LLM providers (see analysis/04-grounding-and-prompts.md)
ANTHROPIC_API_KEY=          # Claude Sonnet 5 answerer + Haiku 4.5 judge (default)
GOOGLE_API_KEY=             # Gemini 3.5 Flash — the A/B provider toggle (optional)

# SQLite location. Local default is ./data/app.db; on Railway point this at the
# mounted persistent volume (e.g. /data/app.db).
DATABASE_PATH=./data/app.db

# Operator control center (/admin) mock gate — not real auth (a non-goal).
ADMIN_PASSCODE=change-me
